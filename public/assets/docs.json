    "users": [
        {
            "method": "GET",
            "path": "/users?board_id=",
            "summary": "Fetch collaborators",
            "params": [
                {
                    "name": "board_id",
                    "type": "integer",
                    "required": true,
                    "desc": "Board to list collaborators for"
                }
            ],
            "body": null,
            "response": "[{ \"id\": 1, \"email\": \"user@example.com\", \"role\": \"Editor\" },...]"
        },
        {
            "method": "POST",
            "path": "/users?board_id=",
            "summary": "Add a collaborator",
            "params": [
                {
                    "name": "board_id",
                    "type": "integer",
                    "required": true,
                    "desc": "Board to add to"
                }
            ],
            "body": [
                {
                    "name": "to_email",
                    "type": "string",
                    "required": true,
                    "desc": "Email of the user to invite"
