{
    "boards": [
        {
            "method": "GET",
            "path": "/boards",
            "summary": "Fetch all boards",
            "params": [
                {
                    "name": "—",
                    "type": "",
                    "required": false,
                    "desc": "No parameters required"
                }
            ],
            "body": null,
            "response": "[{ \"id\": 1, \"name\": \"My Board\", \"color\": \"#ff4757\" },...]"
        },
        {
            "method": "GET",
            "path": "/boards?board_id=",
            "summary": "Fetch single board",
            "params": [
                {
                    "name": "board_id",
                    "type": "integer",
                    "required": true,
                    "desc": "ID of the board to fetch"
                }
            ],
            "body": null,
            "response": "{ \"id\": 1, \"name\": \"My Board\", \"color\": \"#ff4757\" }"
        },
        {
            "method": "POST",
            "path": "/boards",
            "summary": "Create a board",
            "params": null,
            "body": [
                {
                    "name": "name",
                    "type": "string",
                    "required": true,
                    "desc": "Board name"
                },
                {
                    "name": "color",
                    "type": "string",
                    "required": true,
                    "desc": "Hex color e.g. #ff4757"
                }
            ],
            "response": "{ \"id\": 2, \"name\": \"New Board\", \"color\": \"#3742fa\" }"
        },
        {
            "method": "PATCH",
            "path": "/boards?board_id=",
            "summary": "Update a board",
            "params": [
                {
                    "name": "board_id",
                    "type": "integer",
                    "required": true,
                    "desc": "ID of the board to update"
                }
            ],
            "body": [
                {
                    "name": "name",
                    "type": "string",
                    "required": false,
                    "desc": "New board name"
                },
                {
                    "name": "color",
                    "type": "string",
                    "required": false,
                    "desc": "New hex color"
                }
            ],
            "response": "{ \"id\": 1, \"name\": \"Renamed\", \"color\": \"#2ed573\" }"
        },
        {
            "method": "DELETE",
            "path": "/boards?board_id=",
            "summary": "Delete a board",
            "params": [
                {
                    "name": "board_id",
                    "type": "integer",
                    "required": true,
                    "desc": "ID of the board to delete"
                }
            ],
            "body": null,
            "response": "{ \"success\": true }"
        }
    ],
